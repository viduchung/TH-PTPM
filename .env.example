# ====================================================================
# BOOKING SERVICE (NHẬT) - BIẾN MÔI TRƯỜNG MẪU
# Sao chép thành .env (cùng thư mục này) rồi điền giá trị thật. KHÔNG commit file .env.
# Booking tự đọc ./.env hoặc ../.env khi khởi động (spring.config.import).
# ====================================================================

# --- Cổng của Booking Service (mặc định 8083; bảng phân công mới đề xuất 8081 - chờ nhóm thống nhất) ---
BOOKING_SERVICE_PORT=8083

# --- MySQL của Booking (Database-per-Service: chỉ CSDL của Booking) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
BOOKING_DB_NAME=pitchos_booking_db
MYSQL_USERNAME=<ten-dang-nhap-mysql>
MYSQL_PASSWORD=<mat-khau-mysql>

# --- JWT: BẮT BUỘC, phải TRÙNG secret mà Auth Service dùng để ký token (chuỗi Base64, >= 256 bit) ---
JWT_SECRET=<secret-base64-giong-auth-service>

# --- Pitch Service (Provider) ---
PITCH_SERVICE_URL=http://localhost:8082
# webclient (mặc định) | feign
PITCH_CLIENT_TYPE=webclient
PITCH_CONNECT_TIMEOUT_MS=2000
PITCH_RESPONSE_TIMEOUT_MS=3000
PITCH_MAX_RETRIES=2
PITCH_RETRY_BACKOFF_MS=200

# --- TH7: Eureka + LoadBalancer (mặc định tắt) ---
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/
PITCH_DISCOVERY_ENABLED=false
PITCH_SERVICE_ID=pitchos-pitch-service

# --- TH5: quyền chủ sân, FAIL-CLOSED. false (mặc định, an toàn) = chủ sân chỉ được thao tác khi Pitch trả ownerId trùng.
# true = chế độ tương thích KHÔNG AN TOÀN (mọi chủ sân thao tác mọi đơn khi Pitch chưa có ownerId):
#        chỉ dùng khi demo cục bộ với Pitch cũ / giả lập, KHÔNG dùng trong tích hợp thật.
BOOKING_CHUSAN_WITHOUT_OWNER_INFO=false
