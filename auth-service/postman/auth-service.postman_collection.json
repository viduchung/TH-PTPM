{
  "info": {
    "name": "Auth Service - Football Booking (Hoang)",
    "description": "Bộ kiểm thử Postman cho auth-service (port 8080). Phụ trách: Hoàng.\nChạy tuần tự từ trên xuống: Login sẽ tự lưu token vào biến collection {{accessToken}} / {{customerToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "internalKey", "value": "FootballInternalSecretServiceKey2026", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00 - Health (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/auth/health", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "health"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
        ] } }
      ]
    },
    {
      "name": "01 - Login ADMIN (luu accessToken)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin01\",\n  \"password\": \"password123\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "const j = pm.response.json();",
          "pm.test('co accessToken', () => pm.expect(j.accessToken).to.be.a('string').and.not.empty);",
          "pm.test('role = ROLE_ADMIN', () => pm.expect(j.role).to.eql('ROLE_ADMIN'));",
          "pm.collectionVariables.set('accessToken', j.accessToken);"
        ] } }
      ]
    },
    {
      "name": "02 - Login CUSTOMER (luu customerToken)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"customer01\",\n  \"password\": \"password123\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "const j = pm.response.json();",
          "pm.test('role = ROLE_CUSTOMER', () => pm.expect(j.role).to.eql('ROLE_CUSTOMER'));",
          "pm.collectionVariables.set('customerToken', j.accessToken);"
        ] } }
      ]
    },
    {
      "name": "03 - Login SAI mat khau (401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin01\",\n  \"password\": \"saibet\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
        ] } }
      ]
    },
    {
      "name": "04 - Dang ky hop le (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"player{{$randomInt}}\",\n  \"password\": \"secret123\",\n  \"fullName\": \"Cau Thu Moi\",\n  \"phone\": \"09{{$randomInt}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));",
          "pm.test('mac dinh ROLE_CUSTOMER', () => pm.expect(pm.response.json().role).to.eql('ROLE_CUSTOMER'));",
          "pm.test('khong lo password', () => pm.expect(pm.response.text()).to.not.include('passwordHash'));"
        ] } }
      ]
    },
    {
      "name": "05 - Dang ky SAI validation (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"ab\",\n  \"password\": \"123\",\n  \"fullName\": \"X\",\n  \"phone\": \"abc\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
          "pm.test('co chi tiet loi tung truong', () => pm.expect(pm.response.json().errors).to.be.an('object'));"
        ] } }
      ]
    },
    {
      "name": "06 - GET /users KHONG token (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
        ] } }
      ]
    },
    {
      "name": "07 - GET /users CUSTOMER token (403 RBAC)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
        ] } }
      ]
    },
    {
      "name": "08 - GET /users ADMIN token (200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users?page=0&size=10",
          "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"],
          "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }]
        }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('tra ve danh sach phan trang', () => pm.expect(pm.response.json().content).to.be.an('array'));"
        ] } }
      ]
    },
    {
      "name": "09 - GET /auth/me ADMIN (200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('dung username admin01', () => pm.expect(pm.response.json().username).to.eql('admin01'));"
        ] } }
      ]
    },
    {
      "name": "10 - Validate token qua Internal Key (TH6)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Internal-Service-Key", "value": "{{internalKey}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{customerToken}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/validate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "validate"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "const j = pm.response.json();",
          "pm.test('token hop le', () => pm.expect(j.valid).to.be.true);",
          "pm.test('tra ve dung username', () => pm.expect(j.username).to.eql('customer01'));"
        ] } }
      ]
    },
    {
      "name": "11 - Doi vai tro user id=1 (ADMIN) PATCH",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"role\": \"ROLE_FIELD_OWNER\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/users/1/role", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "1", "role"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('vai tro da doi', () => pm.expect(pm.response.json().role).to.eql('ROLE_FIELD_OWNER'));"
        ] } }
      ]
    }
  ]
}
